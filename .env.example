# Copy this file to ".env" and paste the real key after the = sign.
# .env is listed in .gitignore, so it is never pushed to GitHub.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: which Claude model answers the questions (Haiku is the fastest and cheapest).
CLAUDE_MODEL=claude-haiku-5-5

# Optional: Stellar's voice with ElevenLabs. Without this key the browser's built-in voice is used.
ELEVENLABS_API_KEY=your-elevenlabs-key-here
# Optional: choose another voice (copy its Voice ID from elevenlabs.io → Voices) and model.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2
